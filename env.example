# Copy this file to .env and fill in the values.
#   cp env.example .env

# --- Required -------------------------------------------------
# Postgres connection string. For local Docker (see README):
DATABASE_URL=postgres://towgo:towgo@127.0.0.1:55432/towgo
# Signing key for login sessions. Any long random string for dev.
# Required in production - the server refuses to start without it.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Optional: features degrade gracefully if unset -----------
# Map display and place search
VITE_GOOGLE_MAPS_API_KEY=
# AI-powered contextual search
PERPLEXITY_API_KEY=

# Social login (both values needed to enable each provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Outbound email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
